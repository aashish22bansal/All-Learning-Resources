---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search · All Learning Resources">
  <div class="wrap page">
    <h1 class="page__title">Search</h1>
    <p class="page__lede">
      Full text across every note, body copy included. <kbd>Ctrl</kbd>&thinsp;+&thinsp;<kbd>K</kbd>
      opens the same search from anywhere on the site.
    </p>

    <pagefind-searchbox>
      <pagefind-config faceted preload></pagefind-config>
      <pagefind-input placeholder="Search every note"></pagefind-input>
      <pagefind-filter-dropdown filter="domain" label="Domain"></pagefind-filter-dropdown>
      <pagefind-filter-dropdown filter="mastery" label="Confidence"></pagefind-filter-dropdown>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </pagefind-searchbox>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--sp-16) var(--sp-24);
    max-width: 52rem;
  }

  .page__title {
    font-size: var(--size-2xl);
    margin-bottom: var(--sp-3);
  }

  .page__lede {
    color: var(--text-muted);
    margin: 0 0 var(--sp-8);
  }

  kbd {
    font-family: var(--font-ui);
    font-size: 0.85em;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.05em 0.4em;
    color: var(--text);
  }

  pagefind-searchbox {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--ground);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-raised);
    --pagefind-ui-border-radius: var(--radius-lg);
    --pagefind-ui-font: var(--font-ui);
    display: block;
  }
</style>
