---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DomainBadge from '../components/DomainBadge.astro';
import { listDomains } from '../lib/domains.mjs';
import { getLinkGraph, getCrossDomainEdges } from '../lib/links.mjs';
import { noteUrl } from '../lib/routes.mjs';

const notes = await getCollection('notes', ({ data }) => !data.draft);
const { edges } = getLinkGraph();
const cross = getCrossDomainEdges().slice(0, 6);

const counts = new Map<string, number>();
for (const n of notes) {
  if (n.data.domain) counts.set(n.data.domain, (counts.get(n.data.domain) ?? 0) + 1);
}

const domains = listDomains()
  .map((d) => ({ ...d, count: counts.get(d.id) ?? 0 }))
  .sort((a, b) => b.count - a.count);

const stocked = domains.filter((d) => d.count > 0).length;

const recent = [...notes]
  .sort((a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0))
  .slice(0, 6);

const stats = [
  { value: notes.length, label: 'Notes' },
  { value: edges.length, label: 'Links' },
  { value: `${stocked}/${domains.length}`, label: 'Domains' },
];
---

<BaseLayout title="All Learning Resources">
  <section class="hero wrap">
    <p class="hero__eyebrow">A knowledge repository, not a blog</p>
    <h1 class="hero__title">
      Everything worth <span class="g">keeping</span>.
    </h1>
    <p class="hero__lede">
      Notes on whatever I learned that day — databases, networking, language models, strategy,
      whatever it turned out to be. Each one linked to what sits next to it, each one above a stub
      obliged to say where its claims came from.
    </p>

    <dl class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="stat__label">{s.label}</dt>
            <dd class="stat__value">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap section" aria-labelledby="domains-title">
    <div class="section__head">
      <h2 class="section__title" id="domains-title">Domains</h2>
      <a class="section__more" href="/domains/">All domains &rarr;</a>
    </div>

    <ul class="grid">
      {
        domains.map((d) => (
          <li>
            <a
              class="dcard"
              href={`/domains/${d.id}/`}
              style={`--c: var(--domain-${d.id})`}
              data-empty={d.count === 0 ? '' : undefined}
            >
              <span class="dcard__top">
                <span class="dcard__short">{d.short}</span>
                <span class="dcard__count">{d.count}</span>
              </span>
              <span class="dcard__name">{d.name}</span>
              <span class="dcard__blurb">{d.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    cross.length > 0 && (
      <section class="wrap section" aria-labelledby="cross-title">
        <h2 class="section__title" id="cross-title">
          Where domains meet
        </h2>
        <p class="section__lede">
          Links that cross a filing boundary. These are the connections the folder structure would
          never have suggested, and they are usually the ones worth having.
        </p>
        <ul class="crosslist">
          {cross.map((c) => (
            <li class="cross">
              <a class="cross__side" href={c.from.url}>
                <DomainBadge domain={c.from.domain} compact />
                <span>{c.from.title}</span>
              </a>
              <span class="cross__join" aria-hidden="true" />
              <a class="cross__side" href={c.to.url}>
                <DomainBadge domain={c.to.domain} compact />
                <span>{c.to.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap section" aria-labelledby="recent-title">
    <h2 class="section__title" id="recent-title">Recently touched</h2>
    <ul class="grid">
      {
        recent.map((n) => (
          <li>
            <a class="card" href={noteUrl(n)}>
              <DomainBadge domain={n.data.domain} compact />
              <span class="card__title">{n.data.title}</span>
              {n.data.summary && <span class="card__summary">{n.data.summary}</span>}
              <span class="card__foot">{n.data.estMinutes} min</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--sp-24) var(--sp-16);
    max-width: 62rem;
  }

  .hero__eyebrow {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 var(--sp-6);
  }

  .hero__title {
    font-size: var(--size-3xl);
    max-width: 18ch;
    margin-bottom: var(--sp-6);
  }

  .g {
    background: linear-gradient(
      100deg,
      var(--domain-databases, var(--accent)),
      var(--domain-llms, var(--accent)),
      var(--domain-machine-learning, var(--accent))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    max-width: var(--measure);
    font-size: var(--size-lg);
    color: var(--text-muted);
    margin: 0;
    text-wrap: pretty;
  }

  .stats {
    display: flex;
    gap: var(--sp-12);
    margin: var(--sp-12) 0 0;
  }

  .stat__label {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .stat__value {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-ui);
    font-size: var(--size-2xl);
    font-weight: 620;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  /* ---------- Sections ---------- */

  .section {
    padding-block: var(--sp-12);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .section__title {
    font-size: var(--size-xl);
    margin-bottom: var(--sp-3);
  }

  .section__more {
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    color: var(--text-faint);
    text-decoration: none;
  }

  .section__more:hover {
    color: var(--text);
  }

  .section__lede {
    max-width: var(--measure);
    color: var(--text-muted);
    margin: 0 0 var(--sp-8);
  }

  .grid {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--sp-3);
  }

  /* ---------- Domain card ---------- */

  .dcard {
    position: relative;
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    height: 100%;
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color var(--transition), transform var(--transition);
  }

  .dcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--c);
  }

  .dcard:hover {
    border-color: color-mix(in oklab, var(--c) 45%, var(--border));
    transform: translateY(-2px);
  }

  .dcard[data-empty] {
    opacity: 0.55;
  }

  .dcard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dcard__short {
    display: inline-grid;
    place-items: center;
    min-width: 2.2em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: color-mix(in oklab, var(--c) 20%, transparent);
    color: var(--c);
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    font-weight: 650;
  }

  .dcard__count {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
  }

  .dcard__name {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--size-base);
  }

  .dcard__blurb {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ---------- Cross-domain ---------- */

  .crosslist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }

  .cross {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .cross__side {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-width: 0;
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    color: inherit;
    text-decoration: none;
  }

  .cross__side:hover {
    color: var(--accent);
  }

  .cross__side:last-child {
    justify-content: flex-end;
    text-align: right;
  }

  .cross__join {
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(to right, var(--border-strong), var(--border-strong));
  }

  /* ---------- Note card ---------- */

  .card {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    height: 100%;
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition), background var(--transition);
  }

  .card:hover {
    border-color: var(--border-strong);
    background: var(--surface-raised);
  }

  .card__title {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--size-base);
    line-height: 1.35;
  }

  .card__summary {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .card__foot {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    color: var(--text-faint);
  }

  @media (max-width: 40rem) {
    .stats {
      gap: var(--sp-8);
    }
    .cross {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
    .cross__side:last-child {
      justify-content: flex-start;
      text-align: left;
    }
    .cross__join {
      width: 1px;
      height: 1rem;
      margin-left: var(--sp-4);
    }
  }
</style>
